# TextIn 文档解析 API 凭证（必填）
# 在 https://www.textin.com 开发者中心获取
TEXTIN_APP_ID=your_app_id_here
TEXTIN_SECRET_CODE=your_secret_code_here

# OpenAI 兼容 LLM 接口（必填，用于题目结构化抽取）
# 默认使用阿里云 DashScope 的 qwen-flash 模型，速度快、成本低，适合试卷批量抽取场景
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-flash
